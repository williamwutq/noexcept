{
  "name": "noexcept",
  "version": "0.0.0",
  "description": "Graceful, exception-free error handling for TypeScript: Maybe, Option, Result, Either and refinement types, leveraging conditional types for prettier code.",
  "type": "module",
  "author": "William Wu <williamwutq@gmail.com>",
  "license": "MIT",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "keywords": [
    "result",
    "option",
    "either",
    "maybe",
    "error-handling",
    "monad",
    "functional",
    "typescript",
    "neverthrow",
    "branded-types"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0"
  },
  "peerDependencies": {
    "typescript": ">=5.0.0"
  }
}
